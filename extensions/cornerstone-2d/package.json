{
  "name": "@ohif/extension-cornerstone-2d",
  "version": "3.0.3-1",
  "description": "OHIF extension for Cornerstone",
  "author": "OHIF",
  "license": "MIT",
  "repository": "OHIF/Viewers",
  "main": "dist/index.cjs",
  "module": "dist/extensioncornerstone.js",
  "exports": {
    "import": "./dist/extensioncornerstone.esm.js",
    "require": "./dist/index.cjs",
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": ">=14",
    "npm": ">=6",
    "yarn": ">=1.16.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ohif-extension"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --debug --output-pathinfo",
    "dev:cornerstone": "yarn run dev",
    "build": "scripts/build.sh --external:react --external:react-dom --external:cornerstone-core --external:cornerstone-tools --external:cornerstone-math --external:hammerjs --external:@ohif/core --external:@ohif/ui --external:cornerstone-wado-image-loader --external:dicom-parser --external:dcmjs/build/dcmjs.js --external:ohif-step",
    "build:package": "yarn run build",
    "start": "yarn run dev",
    "test:unit": "jest --watchAll",
    "test:unit:ci": "jest --ci --runInBand --collectCoverage"
  },
  "peerDependencies": {
    "@ohif/core": "3.0.1-6",
    "@ohif/ui": "3.0.1-7-alpha.7",
    "cornerstone-core": "2.6.0",
    "cornerstone-math": "0.1.9",
    "cornerstone-tools": "6.0.2",
    "dcmjs": "0.16.1",
    "dicom-parser": "^1.8.9",
    "hammerjs": "^2.0.8",
    "prop-types": "^15.6.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-resize-detector": "^3.4.0"
  },
  "dependencies": {
    "@babel/runtime": "7.16.3",
    "fast-glob": "^3.2.12",
    "lodash.debounce": "4.0.8",
    "lodash.merge": "^4.6.2",
    "path": "^0.12.7",
    "react-cornerstone-viewport": "4.0.5"
  },
  "devDependencies": {
    "esbuild": "^0.15.9"
  }
}
