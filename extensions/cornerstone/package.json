{
  "name": "@ohif/extension-cornerstone",
  "version": "4.0.0-alpha.8",
  "description": "OHIF extension for Cornerstone",
  "author": "OHIF",
  "license": "MIT",
  "repository": "OHIF/Viewers",
  "main": "dist/index.js",
  "module": "src/index.tsx",
  "engines": {
    "node": ">=10",
    "npm": ">=6",
    "yarn": ">=1.16.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --debug --output-pathinfo",
    "dev:cornerstone": "yarn run dev",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "build:package": "yarn run build",
    "build:cjs": "tsc --project ./tsconfig.cjs.json",
    "build:esm": "tsc --project ./tsconfig.esm.json",
    "build:all": "yarn run build:cjs && yarn run build:esm",
    "build:prod": "scripts/build.sh --external:react --external:react-dom --external:@cornerstonejs/core --external:@cornerstonejs/streaming-image-volume-loader --external:cornerstone-math --external:hammerjs --external:@ohif/core --external:@ohif/ui --external:cornerstone-wado-image-loader --external:@cornerstonejs/adapters --external:@cornerstonejs/tools --external:dicom-parser --external:@kitware/vtk.js",
    "start": "yarn run dev"
  },
  "peerDependencies": {
    "@ohif/core": "^3.0.0",
    "@ohif/ui": "^2.0.0",
    "cornerstone-wado-image-loader": "4.13.0",
    "dcmjs": "^0.29.4",
    "dicom-parser": "^1.8.9",
    "hammerjs": "^2.0.8",
    "prop-types": "^15.6.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-resize-detector": "^6.7.6"
  },
  "devDependencies": {
    "lodash": "^4.17.21"
  },
  "dependencies": {
    "@babel/runtime": "7.17.9",
    "@cornerstonejs/adapters": "^0.6.0",
    "@cornerstonejs/core": "1.1.6",
    "@cornerstonejs/streaming-image-volume-loader": "1.1.6",
    "@cornerstonejs/tools": "1.1.6",
    "@kitware/vtk.js": "27.3.1",
    "html2canvas": "^1.4.1",
    "lodash.debounce": "4.0.8",
    "lodash.merge": "^4.6.2",
    "shader-loader": "^1.3.1",
    "worker-loader": "^3.0.8"
  }
}
